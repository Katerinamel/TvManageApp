rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /televisions/{televisionId}/{allPaths=**} {
      allow read: if isAdmin()
        || (signedIn()
          && firestore.get(/databases/(default)/documents/televisions/$(televisionId)).data.deviceId == request.auth.uid);
      allow write: if isAdmin();
    }
  }
}

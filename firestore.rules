rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pairingRequests/{deviceId} {
      allow create: if signedIn()
        && request.auth.uid == deviceId
        && request.resource.data.deviceId == deviceId
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && request.auth.uid == deviceId);
      allow update, delete: if isAdmin();
    }

    match /televisions/{televisionId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.deviceId == request.auth.uid);
      allow create, update, delete: if isAdmin();

      match /contentItems/{contentItemId} {
        allow read: if isAdmin()
          || (signedIn()
            && get(/databases/$(database)/documents/televisions/$(televisionId)).data.deviceId == request.auth.uid);
        allow create, update, delete: if isAdmin();
      }
    }

    match /groups/{groupId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.viewerDeviceIds);
      allow create, update, delete: if isAdmin();

      match /contentItems/{contentItemId} {
        allow read: if isAdmin()
          || (signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.viewerDeviceIds);
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
